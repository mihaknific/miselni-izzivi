{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Puzzles Data Schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "category",
      "subtype",
      "categoryTitle",
      "subtypeTitle",
      "title",
      "prompt",
      "type",
      "hints",
      "explanation"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^puz-\\d+-\\d+-\\d+$" },
      "category": { "type": "string" },
      "subtype": { "type": "string" },
      "categoryTitle": { "type": "string" },
      "subtypeTitle": { "type": "string" },
      "title": { "type": "string", "minLength": 1 },
      "prompt": { "type": "string", "minLength": 1 },
      "type": { "type": "string", "enum": ["multiple_choice", "text_input", "number_input"] },
      "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
      "answers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
      "answer": { "type": "string" },
      "hints": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 3 },
      "explanation": { "type": "string" }
    },
    "additionalProperties": false,
    "oneOf": [{ "required": ["options", "answer"] }, { "required": ["answers"] }]
  }
}
