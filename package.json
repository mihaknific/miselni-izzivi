{
  "name": "miselni-izzivi",
  "version": "1.25.0",
  "description": "Kognitivne igre za vadbo spomina, hitrosti in pozornosti",
  "type": "module",
  "scripts": {
    "dev": "serve .",
    "test": "node --test tests/games.test.js tests/unit.test.js tests/rng.test.js tests/ui.test.js tests/data.test.js tests/icons.test.js",
    "test:all": "node --test tests/**/*.test.js",
    "test:e2e": "playwright test",
    "validate": "node scripts/validate-json.js",
    "lint": "eslint js/ --ext .js",
    "lint:fix": "eslint js/ --ext .js --fix",
    "format": "prettier --write \"**/*.{js,css,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,css,json,md}\"",
    "qa": "npm run validate && npm test && npm run lint",
    "qa:full": "npm run validate && npm test && npm run lint && playwright test",
    "build:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind.min.css -c ./tailwind.config.js --minify"
  },
  "keywords": [
    "pwa",
    "cognitive",
    "games",
    "memory",
    "attention"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "eslint": "10.14.0",
    "prettier": "3.9.6",
    "serve": "14.2.6",
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
